          <div class="profile-row-item"><span>РЕГИСТРАЦИЯ:</span><span id="profileRegDate" style="color: #fff;">01.01.2026</span></div>
        </div>
      </div>
      <div class="profile-details-grid">
        <div class="profile-stat-box"><div class="profile-stat-val" id="profileMapsCount">0</div><div class="profile-stat-lbl">КАРТ СОЗДАНО</div></div>
        <div class="profile-stat-box"><div class="profile-stat-val" id="profileReviewsCount">0</div><div class="profile-stat-lbl">ОТЗЫВОВ</div></div>
