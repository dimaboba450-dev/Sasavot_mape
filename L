      <div class="footer-stat-item">👥 Зарегистрировано: <span id="footerTotalReg" style="color: #ffaa00;">0</span></div>
      <div class="footer-stat-item">🟢 Онлайн на сайте: <span id="footerOnlineCount" style="color: #55ff55;">0</span></div>
