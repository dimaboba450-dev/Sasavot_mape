        <label class="mc-label">ПРИДУМАЙ НИК:</label>
        <input type="text" id="regUsername" class="mc-input">
        <label class="mc-label">ПРИДУМАЙ ПАРОЛЬ:</label>
        <input type="password" id="regPassword" class="mc-input">
        <button class="mc-btn mc-btn-green" id="submitRegisterBtn" style="width: 100%; justify-content: center;">ЗАРЕГИСТРИРОВАТЬСЯ</button>
      </div>
    </div>
  </div>

  <script>
    // ========================================================
    // ⚙️ FIREBASE CONFIGURATION (ВСТАВЬТЕ ВАШИ ДАННЫЕ ИЗ FIREBASE CONSOLE)
    // ========================================================
    const firebaseConfig = {
      apiKey: "YOUR_API_KEY",
      authDomain: "YOUR_PROJECT.firebaseapp.com",
      databaseURL: "https://YOUR_PROJECT-default-rtdb.firebaseio.com",
      projectId: "YOUR_PROJECT",
      storageBucket: "YOUR_PROJECT.appspot.com",
      messagingSenderId: "123456789",
      appId: "1:123456789:web:abcdef"
    };

    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    const DEFAULT_AVATAR = 'https://mc-heads.net/avatar/Steve/64';
    let registeredUsers = {};
    let mapsData = [];
    let activeOnlineUsers = {};
    let currentUser = null;
    let myPresenceRef = null;

    // СИНХРОНИЗАЦИЯ С FIREBASE В РЕАЛЬНОМ ВРЕМЕНИ
    db.ref('users').on('value', snapshot => {
      registeredUsers = snapshot.val() || {};
      updateNavAuth();
      updateFooterStats();
    });

    db.ref('maps').on('value', snapshot => {
      const data = snapshot.val() || {};
      mapsData = Object.values(data);
      renderCards();
    });

    // СИСТЕМА ОНЛАЙНА В РЕАЛЬНОМ ВРЕМЕНИ
    const connectedRef = db.ref('.info/connected');
    connectedRef.on('value', snap => {
      if (snap.val() === true) {
        const mySessionId = db.ref('presence').push();
        myPresenceRef = mySessionId;
        
        mySessionId.onDisconnect().remove();
        mySessionId.set({
          username: currentUser ? currentUser.username : 'Гость',
          online: true
        });
      }
    });

    db.ref('presence').on('value', snapshot => {
      activeOnlineUsers = snapshot.val() || {};
      updateFooterStats();
    });

    function updateFooterStats() {
      const usersList = Object.values(registeredUsers);
      const onlineCount = Object.keys(activeOnlineUsers).length;
      const totalReg = usersList.length;

      document.getElementById('footerTotalReg').innerText = totalReg;
      document.getElementById('footerOnlineCount').innerText = onlineCount;
      document.getElementById('headerOnlineCount').innerText = onlineCount;
      document.getElementById('footerOfflineCount').innerText = Math.max(0, totalReg - onlineCount);
    }

    // РЕГИСТРАЦИЯ
    document.getElementById('submitRegisterBtn').onclick = () => {
      const username = document.getElementById('regUsername').value.trim();
      const password = document.getElementById('regPassword').value.trim();

      if (!username || !password) return alert('Заполни все поля!');
      const userKey = username.toLowerCase();

      if (registeredUsers[userKey]) {
        return alert('❌ Этот никнейм уже занят!');
      }

      const newUser = {
        id: Object.keys(registeredUsers).length + 1,
        username: username,
        password: password,
        role: 'user',
        regDate: new Date().toLocaleDateString('ru-RU'),
        avatar: DEFAULT_AVATAR
      };

      db.ref('users/' + userKey).set(newUser, (err) => {
        if (err) return alert('Ошибка сохранения!');
        currentUser = newUser;
        localStorage.setItem('sasavot_current_user', username);
        if (myPresenceRef) myPresenceRef.update({ username: username });
        closeModal(document.getElementById('registerModal'));
        alert(`🎉 Регистрация успешна, ${username}!`);
      });
    };

    // ВХОД
    document.getElementById('submitLoginBtn').onclick = () => {
      const username = document.getElementById('loginUsername').value.trim();
      const password = document.getElementById('loginPassword').value.trim();
      const userKey = username.toLowerCase();

      const user = registeredUsers[userKey];
      if (user && user.password === password) {
        currentUser = user;
        localStorage.setItem('sasavot_current_user', username);
        if (myPresenceRef) myPresenceRef.update({ username: username });
        closeModal(document.getElementById('loginModal'));
        alert(`С возвращением, ${username}!`);
      } else {
        alert('❌ Неверный логин или пароль!');
      }
    };

    // АВТО-АВТОРИЗАЦИЯ
    const savedName = localStorage.getItem('sasavot_current_user');
    if (savedName) {
      db.ref('users/' + savedName.toLowerCase()).once('value', snap => {
        if (snap.exists()) {
          currentUser = snap.val();
          updateNavAuth();
        }
      });
    }

    function updateNavAuth() {
      const nav = document.getElementById('navAuthSection');
      if (currentUser) {
        nav.innerHTML = `
          <div class="user-badge" onclick="openProfile('${currentUser.username}')">
            <img class="user-avatar-mini" src="${currentUser.avatar || DEFAULT_AVATAR}">
            <span>${currentUser.username}</span>
          </div>
          <button class="mc-btn" id="logoutBtn">Выйти</button>
        `;
        document.getElementById('logoutBtn').onclick = () => {
          localStorage.removeItem('sasavot_current_user');
          currentUser = null;
          updateNavAuth();
        };
      } else {
        nav.innerHTML = `
          <button class="mc-btn" onclick="openModal(document.getElementById('loginModal'))">Войти</button>
          <button class="mc-btn mc-btn-green" onclick="openModal(document.getElementById('registerModal'))">Регистрация</button>
        `;
      }
    }

    function openProfile(username) {
      const userKey = username.toLowerCase();
      const user = registeredUsers[userKey];
      if (!user) return alert('Игрок не найден!');

      document.getElementById('profileUsername').innerText = user.username;
      document.getElementById('profileUserId').innerText = `#${user.id}`;
      document.getElementById('profileRegDate').innerText = user.regDate || '01.01.2026';
      document.getElementById('profileAvatarImg').src = user.avatar || DEFAULT_AVATAR;

      openModal(document.getElementById('profileModal'));
    }

    function renderCards() {
      const container = document.getElementById('cardsContainer');
      container.innerHTML = '';
      if (mapsData.length === 0) {
        container.innerHTML = `<div class="no-maps-notice">📌 НА САЙТЕ ПОКА НЕТ ДОБАВЛЕННЫХ КАРТ.</div>`;
        return;
      }
      mapsData.forEach(map => {
        const card = document.createElement('div');
        card.className = 'map-card';
        card.innerHTML = `
          <div class="map-preview" style="background-image: url('${map.images ? map.images[0] : ''}');"></div>
          <div class="map-details">
            <div class="map-meta"><span class="map-author">${map.author}</span></div>
            <div class="map-card-title">${map.title}</div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function openModal(modal) { modal.classList.add('active'); }
    function closeModal(modal) { modal.classList.remove('active'); }
    document.querySelectorAll('.mc-close-btn').forEach(b => b.onclick = () => closeModal(b.parentElement.parentElement));

    document.getElementById('openOnlineModalBtn').onclick = () => {
      const box = document.getElementById('onlinePlayersList');
      const list = Object.values(activeOnlineUsers);
      box.innerHTML = list.map(u => `
        <div class="online-user-item">
          <span style="font-family: 'Press Start 2P', cursive; font-size: 10px; color: #55ff55;">${u.username}</span>
          <span style="font-size: 8px; color: #55ff55;">🟢 В СЕТИ</span>
        </div>
      `).join('');
      openModal(document.getElementById('onlineModal'));
    };
  </script>
</body>
</html>
