        <button class="mc-close-btn">X</button>
      </div>
      <div class="profile-card-header">
        <img id="profileAvatarImg" class="profile-avatar-large" src="" alt="Avatar">
        <div class="profile-info-box">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div class="profile-nick" id="profileUsername">Steve</div>
            <div id="profileOnlineBadge" style="font-family: 'Press Start 2P', cursive; font-size: 8px; padding: 4px 6px; background: #000; border: 1px solid #55ff55; color: #55ff55;">🟢 В СЕТИ</div>
          </div>
